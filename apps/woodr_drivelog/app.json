{
  "id": "woodr_drivelog",
  "title": "Drive Log",
  "description": "A second-by-second record of every drive (speed, revs, gear, temperatures, g, pedal, tyres) to line up with the dash cam's clips, and every sample during hard acceleration for timing a pull. Read-only.",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OAAG",
  "iconGlyph": "live_data",
  "autostart": true,
  "mguHmi": [
    "ID7"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "longitudinal and lateral g",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the vehicle state number",
      "VehicleCondition": "s"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "gear and selector",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "_optional": "the accelerator pedal",
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tyre pressures and temperatures",
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "the car's display units (TPMS sends in them)",
      "statusNewCurrentUnitsStatusExt": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Drive Log",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "auto",
          "Until the car answers"
        ]
      ]
    }
  ]
}
