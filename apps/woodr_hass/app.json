{
  "id": "woodr_hass",
  "title": "Home Assistant",
  "description": "Your house on the centre screen through Car Relay: garage doors, the front door lock and the doorbell camera on the instrument cluster. Pairs with a QR code, shows only while your phone is in the car, and holds no Home Assistant token",
  "version": "0.2.1",
  "vendor": "custom",
  "loggingId": "OAA8",
  "iconGlyph": "live_data",
  "mguHmi": [
    "ID7"
  ],
  "internet": true,
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "ignition / drive-ready state, for the doorbell safety gate and HA presence",
      "VehicleCondition": "s"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "selector position P/R/N/D, for the doorbell safety gate",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Home Assistant",
      "buttons": [
        [
          "BTN_ACTION",
          "Press the selected tile"
        ],
        [
          "BTN_PAGE",
          "Next tile"
        ],
        [
          "BTN_LOCK",
          "Lock"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "pushCar",
      "label": "Send car state to Home Assistant",
      "type": "bool",
      "default": true
    },
    {
      "key": "pushEvery",
      "label": "Send car state every",
      "type": "number",
      "unit": "s",
      "default": 30,
      "steps": [
        10,
        15,
        30,
        60,
        120,
        300
      ],
      "when": {
        "pushCar": true
      }
    },
    {
      "key": "doorbell",
      "label": "Doorbell on the cluster",
      "type": "choice",
      "default": "parked",
      "options": [
        [
          "off",
          "Off"
        ],
        [
          "parked",
          "Only when stationary"
        ],
        [
          "banner",
          "Text only while moving"
        ],
        [
          "always",
          "Always (not recommended)"
        ]
      ]
    },
    {
      "key": "doorbellSecs",
      "label": "Doorbell shows for",
      "type": "number",
      "unit": "s",
      "default": 20,
      "steps": [
        10,
        15,
        20,
        30,
        45,
        60
      ]
    },
    {
      "key": "contend",
      "label": "Take the cluster slot from BMW",
      "type": "bool",
      "default": false
    },
    {
      "key": "hints",
      "label": "Show a line of text on the lock screen",
      "type": "bool",
      "default": true
    },
    {
      "key": "testBell",
      "label": "Test the doorbell now",
      "type": "bool",
      "default": false
    },
    {
      "key": "reload",
      "label": "Read relay.json again",
      "type": "bool",
      "default": false
    }
  ]
}
