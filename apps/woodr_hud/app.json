{
  "id": "woodr_hud",
  "title": "HUD",
  "description": "A menu on the head-up display worked from the steering wheel: every app's switches and choices in one roller, and a press changes one while the menu stays open. A rev bar across the top of the display that changes colour and blinks at the shift point, and the song CarPlay is playing with its time left. Read-only: signals in, pixels out.",
  "version": "0.4.3",
  "vendor": "custom",
  "loggingId": "OAAE",
  "iconGlyph": "live_data",
  "autostart": true,
  "mguHmi": [
    "ID7"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.SteeringWheelPushButton": {
      "_optional": "the wheel's menu button and right roller that work the HUD menu",
      "statusSpecialFunctionButton": "rs",
      "statusRotarySteps": "rs",
      "statusRotaryPress": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "the song CarPlay is playing, its times and whether it plays, for the song line",
      "_instances": "CarPlayMedia",
      "currentItemMetadata": "rs",
      "currentItemTime": "rs",
      "playerState": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "HUD",
      "buttons": [
        [
          "BTN_ACTION",
          "Rev bar on/off"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "menu",
      "label": "The wheel's menu button opens the HUD menu",
      "type": "bool",
      "default": true,
      "hud": false
    },
    {
      "key": "shift",
      "label": "Show the revs on the head-up display",
      "type": "bool",
      "default": true,
      "hudLabel": "Rev bar"
    },
    {
      "key": "style",
      "label": "Shift display",
      "type": "choice",
      "options": [
        [
          "bar",
          "Rev bar"
        ],
        [
          "frame",
          "Frame round the map"
        ]
      ],
      "default": "bar",
      "hudLabel": "Shift display"
    },
    {
      "key": "place",
      "label": "Rev bar and song position",
      "type": "choice",
      "options": [
        [
          "top",
          "Top of the display"
        ],
        [
          "slot",
          "Lower, clear of the car's own readouts"
        ]
      ],
      "default": "top",
      "hudLabel": "Position"
    },
    {
      "key": "song",
      "label": "Show the song line",
      "type": "bool",
      "default": true,
      "hudLabel": "Song"
    },
    {
      "key": "greenRpm",
      "label": "Green from",
      "type": "number",
      "unit": "rpm",
      "default": 4000,
      "min": 2000,
      "max": 7000,
      "step": 100
    },
    {
      "key": "yellowRpm",
      "label": "Yellow from",
      "type": "number",
      "unit": "rpm",
      "default": 5500,
      "min": 2500,
      "max": 7200,
      "step": 100
    },
    {
      "key": "redRpm",
      "label": "Red from",
      "type": "number",
      "unit": "rpm",
      "default": 6300,
      "min": 3000,
      "max": 7300,
      "step": 100
    },
    {
      "key": "shiftRpm",
      "label": "Flash from",
      "type": "number",
      "unit": "rpm",
      "default": 6800,
      "min": 3500,
      "max": 7400,
      "step": 100
    }
  ]
}
