{
  "id": "woodr_warmhud",
  "title": "Warm-Up HUD",
  "description": "Warm-up on the head-up display: oil, then the gearbox, then the tyres, then it turns itself off. Warns of a low tyre any time.",
  "version": "0.6.9",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "warmup",
  "autostart": true,
  "mguHmi": [
    "ID7"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "gearbox oil temperature when the gearbox unit doesn't answer",
      "basicDataSet": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "read-only diagnostics (UDS 22 only) to read the gearbox temperature",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "_optional": "tyre temperatures for the warm-up and pressures for the low-tyre warning",
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "the car's display units (TPMS sends pressure and temperature in them)",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.body.Light": {
      "_optional": "the high-beam-assistant button: double-tap hides / shows the HUD",
      "IndicatorSteeringColumnComplete": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Warm-Up HUD",
      "buttons": [
        [
          "BTN_ACTION",
          "HUD on/off"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "hud",
      "label": "Show on head-up display",
      "type": "bool",
      "default": true
    },
    {
      "key": "taps",
      "label": "Double-tap the high-beam-assistant button to hide / show (when HUD is not installed)",
      "type": "bool",
      "default": false
    },
    {
      "key": "engineOnly",
      "label": "Only with the engine running",
      "type": "bool",
      "default": true
    },
    {
      "key": "readyAt",
      "label": "Oil ready above",
      "type": "number",
      "unit": "C",
      "default": 90,
      "steps": [
        80,
        85,
        90,
        95,
        100
      ]
    },
    {
      "key": "trans",
      "label": "Gearbox warm-up after oil",
      "type": "bool",
      "default": true
    },
    {
      "key": "transReady",
      "label": "Gearbox ready above",
      "type": "number",
      "unit": "C",
      "default": 70,
      "steps": [
        50,
        60,
        65,
        70,
        75,
        80
      ],
      "when": {
        "trans": true
      }
    },
    {
      "key": "tyres",
      "label": "Tyre warm-up after the gearbox",
      "type": "bool",
      "default": true
    },
    {
      "key": "tyreReady",
      "label": "Tyres ready above",
      "type": "number",
      "unit": "C",
      "default": 25,
      "steps": [
        10,
        15,
        20,
        25,
        30,
        35,
        40
      ],
      "when": {
        "tyres": true
      }
    },
    {
      "key": "pressureWarn",
      "label": "Warn when a tyre is low by",
      "type": "choice",
      "default": "0.2",
      "options": [
        [
          "0",
          "Off"
        ],
        [
          "0.14",
          "0.14 bar / 2 psi"
        ],
        [
          "0.2",
          "0.2 bar / 3 psi"
        ],
        [
          "0.3",
          "0.3 bar / 4 psi"
        ]
      ]
    },
    {
      "key": "pressureUnit",
      "label": "Pressure unit",
      "type": "choice",
      "default": "car",
      "options": [
        [
          "car",
          "Same as the car"
        ],
        [
          "psi",
          "psi"
        ],
        [
          "bar",
          "bar"
        ],
        [
          "kpa",
          "kPa"
        ]
      ]
    },
    {
      "key": "hideWhenReady",
      "label": "Turn off once warm",
      "type": "choice",
      "default": "30",
      "options": [
        [
          "0",
          "Never - keep showing"
        ],
        [
          "10",
          "10 s after ready"
        ],
        [
          "30",
          "30 s after ready"
        ],
        [
          "60",
          "60 s after ready"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperature unit",
      "type": "choice",
      "default": "car",
      "options": [
        [
          "car",
          "Same as the car"
        ],
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    },
    {
      "key": "posY",
      "label": "Vertical position (within the clear area)",
      "type": "number",
      "unit": "px",
      "default": 185,
      "steps": [
        185,
        190,
        195,
        198
      ]
    },
    {
      "key": "scale",
      "label": "Size",
      "type": "choice",
      "default": "100",
      "options": [
        [
          "80",
          "Small"
        ],
        [
          "100",
          "Standard"
        ],
        [
          "110",
          "Large (fits the clear area)"
        ]
      ]
    }
  ]
}
