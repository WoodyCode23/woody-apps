{
  "id": "woodr-link",
  "kind": "tool",
  "version": "0.2.0",
  "title": "Woody Link service",
  "description": "Tailscale for the car, locked down: no exit node, routes or DNS; SSH from your own devices only when you turn it on and your tailnet's rules allow nothing but port 22. Used by the Link app.",
  "mguHmi": ["ID7"],
  "optional": true,
  "uninstallable": true,
  "files": [
    { "path": "bin/tailscaled", "mode": "0755" },
    { "path": "bin/LICENSE-tailscale", "mode": "0644" },
    { "path": "helper.js", "mode": "0644" },
    { "path": "README.md", "mode": "0644" }
  ],
  "units": [
    { "name": "woodr-link.service" },
    { "name": "woodr-link-helper.service" }
  ],
  "enable": [
    { "unit": "woodr-link.service", "target": "oapcontroller.service" },
    { "unit": "woodr-link-helper.service", "target": "oapcontroller.service" }
  ],
  "restart": ["woodr-link.service", "woodr-link-helper.service"],
  "keepRunning": true,
  "internet": true,
  "uids": [3921]
}
